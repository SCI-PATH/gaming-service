{
  "name": "gaming-service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "backend": "npm run dev -w backend",
    "frontend": "npm run dev -w frontend",
    "dev": "node scripts/dev-help.mjs",
    "dev:backend": "npm run backend",
    "dev:frontend": "npm run frontend",
    "build": "npm run build -w frontend",
    "preview": "npm run preview -w frontend",
    "lint": "oxlint frontend backend",
    "ingest:textbooks": "python scripts/ingest_textbooks.py"
  },
  "devDependencies": {
    "oxlint": "^1.71.0"
  }
}
