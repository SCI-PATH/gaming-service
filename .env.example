# Avatar mentor AI (Groq Cloud — do NOT run LLMs locally)
# ------------------------------
# Endpoint: https://api.groq.com/openai/v1/chat/completions
LLAMA_PROVIDER=groq
LLAMA_MODEL=llama-3.3-70b-versatile
# Alternate faster model: llama-3.1-8b-instant
LLAMA_TEMPERATURE=0.7
AVATAR_MAX_TOKENS=180
AVATAR_TIMEOUT_MS=30000

# Required for live mentor replies
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional legacy providers (not recommended for grade 6–9 laptops)
OLLAMA_BASE_URL=http://localhost:11434
AVATAR_PORT=8787
