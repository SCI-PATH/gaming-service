# Neon Postgres (engagement_gaming research DB)
# Must start with postgresql:// or postgres:// — sqlite:// and https:// will fail Neon with "incorrect scheme".
# Example: postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Leave blank to keep the arena leaderboard in backend/data/app.json
DATABASE_URL=

# Avatar mentor AI (Groq Cloud — do NOT run LLMs locally)
# ------------------------------
# Endpoint: https://api.groq.com/openai/v1/chat/completions
LLAMA_PROVIDER=groq
# Groq retired llama-3.3-70b-versatile — use a current catalog model:
LLAMA_MODEL=openai/gpt-oss-120b
# Faster / lighter alternate: openai/gpt-oss-20b
LLAMA_TEMPERATURE=0.7
AVATAR_MAX_TOKENS=180
AVATAR_TIMEOUT_MS=30000

# Required for live mentor replies
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter — used ONLY when Groq cannot answer with enough knowledge.
# Leave blank to keep Groq-only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional legacy providers (not recommended for grade 6–9 laptops)
OLLAMA_BASE_URL=http://localhost:11434
AVATAR_PORT=8002

# Vite proxies /api → gaming backend (restart `npm run frontend` after changing):
GAMING_API_PROXY_TARGET=http://3.6.20.31:8002
# Local backend instead:
# GAMING_API_PROXY_TARGET=http://127.0.0.1:8002

# Assessment Engine (science quiz — frontend Vite vars)
VITE_ASSESSMENT_DEPLOYED_BASE=http://43.204.6.115:8004
VITE_ASSESSMENT_LOCAL_BASE=http://localhost:8004
# Vite proxies /assessment-api → this host (restart `npm run frontend` after changing):
# ASSESSMENT_API_PROXY_TARGET=http://43.204.6.115:8004
# Optional override tried first, then LOCAL:
# VITE_ASSESSMENT_API_BASE=
